# KARIAKOO environment variables
# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored. This file must only ever contain PLACEHOLDERS.

# --- Supabase (public, safe in the browser) --------------------------------
# Supabase Dashboard > Project Settings > API. Access is limited by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# --- Supabase (SERVER ONLY, never prefix with NEXT_PUBLIC_) -----------------
# Bypasses Row Level Security. Only for trusted server jobs such as payment
# webhooks (Phase 4). Not needed yet.
# SUPABASE_SECRET_KEY=sb_secret_your_key

# --- Maps (optional) --------------------------------------------------------
# Without a key the rider map uses keyless CARTO tiles (development use;
# check CARTO's terms before commercial launch). With a MapTiler key, MapTiler
# tiles are used instead. Restrict the key to your domain in MapTiler.
# NEXT_PUBLIC_MAPTILER_API_KEY=your_maptiler_key

# --- Payments (Phase 4, SERVER ONLY) ----------------------------------------
# A provider appears at checkout only when its key is set on the server.
# MPESA_API_KEY=
# MIXX_API_KEY=
# AIRTEL_MONEY_API_KEY=
# HALOPESA_API_KEY=
# PAYMENT_WEBHOOK_SECRET=
